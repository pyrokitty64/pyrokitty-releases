{
    "name": "pyrokitty-ui",
    "version": "0.1.50",
    "description": "PyroKitty Viewer Manager - Multi-account Second Life/OpenSim launcher",
    "main": "dist/main/index.js",
    "scripts": {
        "start": "npm run build && electron .",
        "dev": "npm run build && concurrently --kill-others \"npm run watch:main\" \"npm run watch:renderer\" \"electron .\"",
        "build": "npm run build:metaverse && npm run build:main && npm run build:renderer && npm run build:map && npm run build:3d-map && npm run build:gpu-compress && npm run build:sound-player",
        "build:metaverse": "cd node-metaverse && npm run build",
        "build:voice": "cd voice && dotnet publish -c Release -r win-x64 --self-contained -o ../dist/voice",
        "build:main": "esbuild src/main/index.ts --bundle --outfile=dist/main/index.js --platform=node --target=node18 --format=cjs --external:electron --external:sharp && esbuild src/main/assets/texture-decode-worker.ts --bundle --outfile=dist/main/texture-decode-worker.js --platform=node --target=node18 --format=cjs --external:sharp && esbuild src/main/assets/mesh-convert-worker.ts --bundle --outfile=dist/main/mesh-convert-worker.js --platform=node --target=node18 --format=cjs --external:electron",
        "build:gpu-compress": "esbuild src/gpu-compress/compress.ts --bundle --outfile=dist/gpu-compress/compress.js --platform=browser --target=chrome120 --external:electron && node -e \"const fs=require('fs');fs.copyFileSync('src/gpu-compress/index.html','dist/gpu-compress/index.html');fs.copyFileSync('src/gpu-compress/bc-compress.wgsl','dist/gpu-compress/bc-compress.wgsl');\"",
        "build:sound-player": "esbuild src/sound-player/player.ts --bundle --outfile=dist/sound-player/player.js --platform=browser --target=chrome120 --external:electron && node -e \"const fs=require('fs');fs.copyFileSync('src/sound-player/index.html','dist/sound-player/index.html');\"",
        "build:renderer": "esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/index.js --platform=browser --target=chrome114 --external:electron && esbuild src/renderer/styles/index.css --bundle --outfile=dist/renderer/styles/index.css && npm run copy:assets",
        "build:map": "esbuild src/map-renderer/index.tsx --bundle --outfile=dist/map-renderer/index.js --platform=browser --target=chrome114 --external:electron && esbuild src/map-renderer/styles/index.css --bundle --outfile=dist/map-renderer/styles/index.css --loader:.png=file --asset-names=[name] && npm run copy:map-assets",
        "copy:assets": "node -e \"const fs=require('fs');fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html');\"",
        "build:3d-map": "esbuild src/3d-map/index.ts --bundle --outfile=dist/3d-map/index.js --platform=browser --target=chrome120 --external:electron && esbuild src/3d-map/styles/index.css --bundle --outfile=dist/3d-map/styles/index.css && npm run copy:3d-map-assets",
        "copy:3d-map-assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/3d-map',{recursive:true});fs.copyFileSync('src/3d-map/index.html','dist/3d-map/index.html');\"",
        "copy:map-assets": "node -e \"const fs=require('fs');fs.copyFileSync('src/map-renderer/map.html','dist/map-renderer/map.html');\"",
        "watch:main": "esbuild src/main/index.ts --bundle --outfile=dist/main/index.js --platform=node --target=node18 --format=cjs --external:electron --watch",
        "watch:renderer": "concurrently \"esbuild src/renderer/index.tsx --bundle --outfile=dist/renderer/index.js --platform=browser --target=chrome114 --external:electron --watch\" \"esbuild src/renderer/styles/index.css --bundle --outfile=dist/renderer/styles/index.css --watch\"",
        "pack": "electron-builder --dir",
        "dist": "electron-builder",
        "package": "bash scripts/package.sh",
        "knip": "knip",
        "cpd": "jscpd src/ scripts/ --min-lines 6 --min-tokens 50",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write src/",
        "format:check": "prettier --check src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:voice": "cd voice/tests && dotnet test --no-restore",
        "test:godot": "bash scripts/test-godot.sh",
        "pre:commit": "npm run test && npm run test:voice && npm run test:godot"
    },
    "author": "PyroKitty",
    "license": "LGPL-2.1",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/leaflet": "^1.9.21",
        "@types/leaflet.markercluster": "^1.5.6",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/ws": "^8.5.0",
        "@webgpu/types": "^0.1.69",
        "concurrently": "^8.2.0",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0",
        "esbuild": "^0.19.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "jscpd": "^4.0.8",
        "knip": "^5.84.1",
        "prettier": "^3.8.1",
        "typescript": "^5.3.0",
        "typescript-eslint": "^8.57.0",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@abasb75/jpeg2000-decoder": "file:../wasm-openjpeg/packages/2.5.4-decoder",
        "@mantine/core": "^8.3.14",
        "@mantine/hooks": "^8.3.14",
        "@react-leaflet/core": "^2.1.0",
        "@types/three": "^0.183.1",
        "chokidar": "^5.0.0",
        "fast-xml-parser": "^5.5.5",
        "leaflet": "^1.9.4",
        "leaflet.markercluster": "^1.5.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-leaflet": "^4.2.1",
        "react-leaflet-markercluster": "^3.0.0-rc1",
        "sharp": "^0.34.5",
        "three": "^0.183.2",
        "ws": "^8.16.0"
    },
    "build": {
        "appId": "com.pyrokitty.viewer-manager",
        "productName": "PyroKitty",
        "directories": {
            "output": "../../pyrokitty-release"
        },
        "files": [
            "dist/**/*",
            "data/grids.json",
            "node_modules/sharp/**/*",
            "node_modules/@img/**/*"
        ],
        "asarUnpack": [
            "node_modules/@img/**/*",
            "node_modules/sharp/**/*"
        ],
        "extraFiles": [
            {
                "from": "launcher/PyroKitty.sh",
                "to": "PyroKitty.sh"
            }
        ],
        "extraResources": [
            {
                "from": "viewer",
                "to": "viewer",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "godot-viewer-staging",
                "to": "godot-viewer",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "voice-staging",
                "to": "voice",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../shared",
                "to": "shared",
                "filter": [
                    "*.json"
                ]
            },
            {
                "from": "../icons/pyrokitty2.ico",
                "to": "icons/pyrokitty2.ico"
            },
            {
                "from": "../icons/pyrokitty2_16.png",
                "to": "icons/pyrokitty2_16.png"
            },
            {
                "from": "../icons/map-icon.ico",
                "to": "icons/map-icon.ico"
            },
            {
                "from": "../icons/map-icon_16.png",
                "to": "icons/map-icon_16.png"
            }
        ],
        "win": {
            "target": [
                "dir",
                "7z"
            ],
            "artifactName": "PyroKitty-Launcher-${version}-win64.${ext}",
            "icon": "../icons/pyrokitty2.ico"
        },
        "linux": {
            "target": [
                "dir"
            ],
            "icon": "../icons/pyrokitty2.png"
        }
    }
}
